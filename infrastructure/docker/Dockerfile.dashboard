FROM node:24.15.0-bookworm-slim AS build
WORKDIR /repo
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @prc/dashboard-angular... build

FROM nginx:1.27-alpine
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/nginx-proxy.inc /etc/nginx/snippets/prc-proxy.inc
COPY --from=build /repo/apps/dashboard-angular/dist/dashboard-angular/browser /usr/share/nginx/html
