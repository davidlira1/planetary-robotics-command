generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RobotType {
  SCOUT
  DRONE
  HAULER
  WORKER
  MINER
}

enum RobotOperationalStatus {
  OFFLINE
  IDLE
  ACTIVE
  CHARGING
  FAULTED
}

enum RobotHealthStatus {
  HEALTHY
  WARNING
  CRITICAL
}

enum HealthDimensionStatus {
  NORMAL
  WARNING
  CRITICAL
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
}

enum AlertType {
  LOW_BATTERY
  HIGH_TEMPERATURE
  SIGNAL_DEGRADED
}

model Robot {
  id                String                 @id
  displayName       String
  type              RobotType
  model             String
  operationalStatus RobotOperationalStatus
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  currentState      RobotCurrentState?
  telemetry         RobotTelemetry[]
  healthState       RobotHealthState?
  alerts            Alert[]
}

model RobotCurrentState {
  robotId                 String   @id
  positionX               Float
  positionY               Float
  positionZ               Float
  batteryPercent          Float
  temperatureCelsius      Float
  signalStrengthDbm       Float
  velocityMetersPerSecond Float
  headingDegrees          Float
  recordedAt              DateTime
  receivedAt              DateTime
  robot                   Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
}

model RobotTelemetry {
  id                      String   @id
  robotId                 String
  sourceTelemetryId       String
  schemaVersion           Int
  positionX               Float
  positionY               Float
  positionZ               Float
  batteryPercent          Float
  temperatureCelsius      Float
  signalStrengthDbm       Float
  velocityMetersPerSecond Float
  headingDegrees          Float
  recordedAt              DateTime
  receivedAt              DateTime
  robot                   Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@unique([robotId, sourceTelemetryId])
  @@index([robotId])
  @@index([robotId, recordedAt])
  @@index([recordedAt])
}

model OutboxMessage {
  id               String    @id
  eventId          String    @unique
  eventType        String
  eventVersion     Int
  occurredAt       DateTime
  correlationId    String
  causationId      String
  payloadJson      String
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?
  publishAttempts  Int       @default(0)
  lastPublishError String?
  claimedUntil     DateTime?

  @@index([publishedAt, createdAt])
  @@index([claimedUntil])
}

model RobotHealthState {
  robotId                   String                @id
  status                    RobotHealthStatus
  batteryStatus             HealthDimensionStatus
  temperatureStatus         HealthDimensionStatus
  signalStatus              HealthDimensionStatus
  evaluatedFromTelemetryId  String
  evaluatedFromRecordedAt   DateTime
  updatedAt                 DateTime
  robot                     Robot                 @relation(fields: [robotId], references: [id], onDelete: Restrict)
}

model Alert {
  id                String        @id
  robotId           String
  type              AlertType
  severity          AlertSeverity
  status            AlertStatus
  title             String
  message           String
  sourceTelemetryId String
  sourceEventId     String
  createdAt         DateTime      @default(now())
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  robot             Robot         @relation(fields: [robotId], references: [id], onDelete: Restrict)

  @@index([robotId, type])
  @@index([sourceEventId])
}

model ProcessedMessage {
  consumer    String
  eventId     String
  processedAt DateTime @default(now())

  @@id([consumer, eventId])
  @@index([processedAt])
}
