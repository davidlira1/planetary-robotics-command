NODE_ENV=production
NGINX_PORT=80
NGINX_TLS_PORT=443

POSTGRES_USER=prc
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=prc

RABBITMQ_USER=prc
RABBITMQ_PASSWORD=replace-me

RABBITMQ_MAX_DELIVERY_COUNT=10
RABBITMQ_RETRY_TTL_MS=2000

MESSAGE_BROKER_PROVIDER=rabbitmq

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_CLAIM_DURATION_MS=30000
OUTBOX_BATCH_SIZE=20

TELEMETRY_INTERVAL_MS=2000
SIMULATION_TICK_MS=100

TELEMETRY_RETENTION_HOURS=2
PUBLISHED_OUTBOX_RETENTION_HOURS=2
PROCESSED_MESSAGE_RETENTION_HOURS=24
RETENTION_INTERVAL_MINUTES=10
