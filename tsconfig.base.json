{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@prc/domain": ["libs/domain/src/index.ts"],
      "@prc/ports": ["libs/ports/src/index.ts"],
      "@prc/contracts": ["libs/contracts/src/index.ts"],
      "@prc/application": ["libs/application/src/index.ts"],
      "@prc/persistence-prisma": ["libs/infrastructure/persistence/prisma-postgres/src/index.ts"]
    }
  }
}
