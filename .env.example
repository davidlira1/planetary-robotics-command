NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://prc:prc@localhost:5432/prc?schema=public

# Docker / Service Bus emulator
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Your_password123
MESSAGE_BROKER_PROVIDER=azure-service-bus
SERVICE_BUS_TELEMETRY_TOPIC=robot.telemetry.received
SERVICE_BUS_HEALTH_SUBSCRIPTION=health
SERVICE_BUS_REALTIME_SUBSCRIPTION=realtime
REALTIME_GATEWAY_PORT=3001
REALTIME_GATEWAY_PATH=/realtime
# Emulator connection string (UseDevelopmentEmulator=true)
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_CLAIM_DURATION_MS=30000
OUTBOX_BATCH_SIZE=20

# Layer 3 — robot simulator
SIMULATOR_API_BASE_URL=http://localhost:3000
SIMULATION_TICK_MS=100
TELEMETRY_INTERVAL_MS=1000
# SIMULATION_SEED=12345
SIMULATION_WORLD_MIN_X=-1000
SIMULATION_WORLD_MAX_X=1000
SIMULATION_WORLD_MIN_Z=-1000
SIMULATION_WORLD_MAX_Z=1000
SIMULATION_MAX_ALTITUDE=300
SIMULATION_BASE_X=0
SIMULATION_BASE_Y=0
SIMULATION_BASE_Z=0
TELEMETRY_MAX_ATTEMPTS=5
TELEMETRY_RETRY_INITIAL_MS=500
TELEMETRY_RETRY_MAX_MS=8000
# Optional threshold demo (battery WARNING is < 20)
# SIM_D04_BATTERY=19
# SIMULATOR_DEBUG=1
