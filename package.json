{
  "name": "planetary-robotics-command",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "pnpm --filter @prc/domain build && pnpm --filter @prc/ports build && pnpm --filter @prc/contracts build && pnpm --filter @prc/application build && pnpm --filter @prc/persistence-prisma build && pnpm --filter @prc/api build",
    "dev": "pnpm --filter @prc/api start:dev",
    "start": "pnpm --filter @prc/api start:prod",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @prc/application test && pnpm --filter @prc/domain test",
    "test:integration": "pnpm --filter @prc/persistence-prisma test && pnpm --filter @prc/api test:e2e",
    "migrate": "pnpm --filter @prc/persistence-prisma migrate:dev",
    "migrate:deploy": "pnpm --filter @prc/persistence-prisma migrate:deploy",
    "seed": "pnpm --filter @prc/persistence-prisma seed",
    "openapi:export": "pnpm --filter @prc/contracts openapi:export",
    "openapi:check": "pnpm --filter @prc/contracts openapi:check",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
